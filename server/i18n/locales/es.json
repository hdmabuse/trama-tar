  "glossary": {
    "title": "Glosario",
    "actante": "Entidad que actúa y es afectada por otras. Puede ser humano, tecnología, institución, idea o naturaleza.",
    "traduccion": "Proceso por el cual un actante media los intereses de otros, creando nuevos caminos y significados en la red.",
    "mediador": "Actante que transforma, traduce e influye en otros. A diferencia de un mero transmisor, el mediador modifica lo que pasa por él.",
    "intermediario": "Actante que solo transmite información sin modificar su contenido o significado.",
    "plasma": "Dominio de lo aún no representado. Todo lo que aún no se ha mapeado pero que potencialmente puede participar en la red.",
    "caja_negra": "Cuando una red se estabiliza y funciona como una unidad, volviéndose 'invisible' — como la electricidad o internet.",
    "immutable_movel": "Entidad que puede circular sin ser alterada, pero que reordena la red. Datos, documentos, estándares técnicos.",
    "controversia": "Tema social que divide a los actantes con diferentes posiciones sobre un tema."
  },
  "landing": {
    "title": "Mapeo de Redes usando la Teoría Actor-Red",
    "subtitle": "Una plataforma de código abierto para investigadores mapear controversias, redes sociales y relaciones sociotécnicas usando los principios de la ANT.",
    "cta": "Comenzar a Mapear",
    "ctaSecondary": "Acceder a la Plataforma",
    "features": {
      "actantes": {
        "title": "Actantes",
        "description": "No solo 'actores' — incluya humanos, tecnologías, instituciones, ideas y cualquier entidad que participe en la red."
      },
      "associacoes": {
        "title": "Asociaciones",
        "description": "Documente relaciones, traducciones, mediaciones y antagonismos entre actantes. Descubra quién traduce a quién."
      },
      "redes": {
        "title": "Redes Completas",
        "description": "Visualice la red como un todo. Rastreé la fluidez de las relaciones e identifique a los mediadores centrales."
      }
    },
    "about": {
      "title": "¿Qué es la Teoría Actor-Red?",
      "description": "La Teoría Actor-Red (ANT), desarrollada por Bruno Latour, Michel Callon y John Law, es un enfoque que trata al mundo como una red compuesta por actantes heterogéneos."
    },
    "concepts": {
      "title": "Conceptos Fundamentales"
