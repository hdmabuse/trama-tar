  "glossary": {
    "title": "Glossário",
    "actante": "Entidade que age e é afetada por outras. Pode ser humano, tecnologia, instituição, ideia ou natureza.",
    "traducao": "Processo pelo qual um actante intermedeia os interesses de outros, criando novos caminhos e significados na rede.",
    "mediador": "Actante que transforma, traduz e influencia outros. Diferente de mero transmissor, o mediador modifica o que passa por ele.",
    "intermediario": "Actante que apenas transmite informação sem modificar seu conteúdo ou significado.",
    "plasma": "Domínio do não-representado ainda. Tudo que ainda não foi mapeado, mas que potencialmente pode participar da rede.",
    "caixa_preta": "Quando uma rede se estabiliza e funciona como uma unidade, tornando-se 'invisível' — como a eletricidade ou a internet.",
    "immutable_movel": "Entidade que pode circular sem ser alterada, mas que rearranja a rede. Dados, documentos, padrões técnicos.",
    "controversia": "Issue social que divide actantes com posições distintas sobre um tema."
  },
  "landing": {
    "title": "Mapeamento de Redes pela Teoria Ator-Rede",
    "subtitle": "Uma plataforma open source para pesquisadores mapearem controvérsias, redes sociais e relações sociotécnicas usando os princípios da ANT.",
