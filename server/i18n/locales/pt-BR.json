      "redes": {
        "title": "Redes Completas",
        "description": "Visualize a rede como um todo. Trace a fluidez das relações e identifique os mediadores centrais."
      }
    },
    "about": {
      "title": "O que é a Teoria Ator-Rede?",
      "description": "A Teoria Ator-Rede (ANT), desenvolvida por Bruno Latour, Michel Callon e John Law, é uma abordagem que trata o mundo como uma rede composta por actantes heterogêneos."
    },
