      "associacoes": {
        "title": "Associations",
        "description": "Document relations, translations, mediations and antagonisms between actants. Discover who translates whom."
      },
      "redes": {
        "title": "Complete Networks",
        "description": "Visualize the network as a whole. Trace the fluidity of relations and identify central mediators."
      }
    },
    "about": {
      "title": "What is Actor-Network Theory?",
      "description": "Actor-Network Theory (ANT), developed by Bruno Latour, Michel Callon and John Law, is an approach that treats the world as a network composed of heterogeneous actants."
