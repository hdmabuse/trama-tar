  "glossary": {
    "title": "Glossary",
    "actant": "Entity that acts and is affected by others. Can be human, technology, institution, idea or nature.",
    "traducao": "Process by which an actant mediates the interests of others, creating new paths and meanings in the network.",
    "mediador": "Actant that transforms, translates and influences others. Unlike a mere transmitter, the mediator modifies what passes through it.",
    "intermediario": "Actant that only transmits information without modifying its content or meaning.",
    "plasma": "Domain of the not-yet-represented. Everything not yet mapped but that can potentially participate in the network.",
    "caixa_preta": "When a network stabilizes and functions as a unit, becoming 'invisible' — like electricity or the internet.",
    "immutable_movel": "Entity that can circulate without being altered, but that rearranges the network. Data, documents, technical standards.",
    "controversy": "Social issue that divides actants with different positions on a topic."
  },
  "landing": {
    "title": "Network Mapping using Actor-Network Theory",
    "subtitle": "An open source platform for researchers to map controversies, social networks and sociotechnical relations using ANT principles.",
